#!/usr/bin/env python3
"""
mt_forward_to_edi.py

Convert a custom MT forward-simulation output file into one SEG-EDI file
per station.

EXPECTED INPUT FORMAT
----------------------
Line 1: nloc, ncomp, nfreq                 (e.g. 2025, 6, 35)
Line 2: component names                    (e.g. ZXX ZXY ZYX ZYY TZX TZY)
Line 3: nfreq frequency values, descending order

Then, repeated for each of the nloc stations, 2*ncomp lines:
    Xloc Yloc CODE  v_f1 v_f2 ... v_fnfreq

where CODE is componentname + 'R' or 'I', e.g. ZXXR, ZXXI, ZXYR, ZXYI,
ZYXR, ZYXI, ZYYR, ZYYI, TZXR, TZXI, TZYR, TZYI (order must match the
real/imag pairs for each component listed on line 2, but the parser
below is order-independent -- it keys everything off the CODE string,
so lines can appear in any order within a station block).

Values on each row may be separated by any whitespace. Fields on the
Xloc/Yloc/CODE part may also be comma-separated -- the parser accepts
both.

USAGE
-----
    python csv2edi.py input.txt --outdir edi_out

Useful options:
    --coord-type latlon|utm     how to interpret Xloc/Yloc (default: latlon)
    --utm-zone 11 --utm-hemisphere N   required if --coord-type utm
    --unit-conversion none|si2field    apply SI(Ohm)->field(mV/km/nT) (default: none)
    --error-fraction 0.05        fractional error assigned to VAR blocks (default 0.05)
    --station-prefix SITE        station name prefix (default: derived from index)

NOTES ON UNITS
--------------
EDI files conventionally store impedance in field units, mV/km/nT.
If your forward code outputs SI impedance (Ohms), pass
--unit-conversion si2field to apply the standard conversion factor
    Z_field [mV/km/nT] = Z_SI [Ohm] * 795.775
This is the widely used MT convention (see e.g. Simpson & Bahr, 2005).
If your simulator already outputs field units, leave this off (default).
Tipper is dimensionless in both systems and is never converted.

NOTES ON ERRORS/VARIANCE
-------------------------
Forward-modeled (noise-free) data has no natural error estimate, but
many inversion codes choke on exactly-zero errors/variances. This
script assigns VAR = (error_fraction * |value|)^2, with a small floor
so that exact-zero responses still get a nonzero variance.
"""

import argparse
import math
import os
import re
import sys
from collections import defaultdict

Z_COMPONENTS = ["ZXX", "ZXY", "ZYX", "ZYY"]
T_COMPONENTS = ["TZX", "TZY"]
ALL_COMPONENTS = Z_COMPONENTS + T_COMPONENTS

SI_TO_FIELD = 795.775  # Ohm -> mV/km/nT


def tokenize_line(line):
    """Split a line on commas and/or whitespace."""
    line = line.strip()
    if not line:
        return []
    # Replace commas with spaces, then split on whitespace
    return line.replace(",", " ").split()


def parse_input(path):
    with open(path, "r") as f:
        lines = [ln for ln in f.read().splitlines() if ln.strip() != ""]

    idx = 0
    header = tokenize_line(lines[idx]); idx += 1
    nloc, ncomp, nfreq = int(float(header[0])), int(float(header[1])), int(float(header[2]))

    comp_names = tokenize_line(lines[idx]); idx += 1
    comp_names = [c.upper() for c in comp_names]

    freq_tokens = tokenize_line(lines[idx]); idx += 1
    freqs = [float(x) for x in freq_tokens]
    if len(freqs) != nfreq:
        # Some files wrap the frequency line across multiple lines; keep reading
        while len(freqs) < nfreq:
            freq_tokens = tokenize_line(lines[idx]); idx += 1
            freqs.extend(float(x) for x in freq_tokens)

    stations = []  # list of dicts: {loc:(x,y), data: {CODE: [values...]}}
    n_data_lines = nloc * 2 * ncomp

    cur_loc = None
    cur_data = None

    lines_consumed = 0
    while lines_consumed < n_data_lines and idx < len(lines):
        row = tokenize_line(lines[idx]); idx += 1
        lines_consumed += 1

        x_tok, y_tok, code = row[0], row[1], row[2].upper()
        values = [float(v) for v in row[3:]]
        # Handle wrapped value rows (values split across multiple lines)
        while len(values) < nfreq and idx < len(lines):
            extra = tokenize_line(lines[idx])
            # heuristic: if next line looks like a new record (3 leading
            # non-numeric-ish tokens incl a CODE), stop wrapping
            if len(extra) >= 3 and re.match(r"^[A-Z]{2,4}[RI]$", extra[2].upper()):
                break
            idx += 1
            values.extend(float(v) for v in extra)
            lines_consumed += 1
        if len(values) != nfreq:
            raise ValueError(
                f"Expected {nfreq} values for {code} at ({x_tok},{y_tok}), got {len(values)}"
            )

        x, y = float(x_tok), float(y_tok)
        if cur_loc is None or (x, y) != cur_loc:
            if cur_loc is not None:
                stations.append({"loc": cur_loc, "data": cur_data})
            cur_loc = (x, y)
            cur_data = {}
        cur_data[code] = values

    if cur_loc is not None:
        stations.append({"loc": cur_loc, "data": cur_data})

    if len(stations) != nloc:
        print(
            f"WARNING: parsed {len(stations)} stations, header says nloc={nloc}. "
            "Check the input format / wrapped lines.",
            file=sys.stderr,
        )

    return freqs, stations


def build_complex(data, comp, nfreq):
    """Return list of complex values for a component, or None if absent."""
    r_key, i_key = comp + "R", comp + "I"
    if r_key not in data or i_key not in data:
        return None
    reals, imags = data[r_key], data[i_key]
    return [complex(r, i) for r, i in zip(reals, imags)]


def fmt(v, width=13, prec=6):
    return f"{v: .{prec}E}"


def wrap_values(values, per_line=6):
    """Yield lines of space-separated formatted floats, N per line."""
    out_lines = []
    for i in range(0, len(values), per_line):
        chunk = values[i:i + per_line]
        out_lines.append("  " + " ".join(fmt(v) for v in chunk))
    return out_lines


def utm_to_latlon(easting, northing, zone, hemisphere):
    try:
        from pyproj import Transformer
    except ImportError:
        raise RuntimeError(
            "UTM coordinates requested but pyproj is not installed. "
            "Run: pip install pyproj --break-system-packages"
        )
    south = hemisphere.upper() == "S"
    crs = f"+proj=utm +zone={zone} +{'south' if south else ''} +ellps=WGS84"
    transformer = Transformer.from_crs(crs, "epsg:4326", always_xy=True)
    lon, lat = transformer.transform(easting, northing)
    return lat, lon


def write_edi(path, station_name, lat, lon, elev, freqs, z, zvar, t, tvar, ncomp_avail):
    """
    z: dict comp -> list[complex] or None      (comp in ZXX,ZXY,ZYX,ZYY)
    zvar: dict comp -> list[float] or None      (variance, per component, shared R/I)
    t: dict comp -> list[complex] or None       (comp in TZX,TZY)
    tvar: dict comp -> list[float] or None
    """
    nfreq = len(freqs)
    lines = []

    lines.append(">HEAD")
    lines.append(f'    DATAID="{station_name}"')
    lines.append('    ACQBY="FORWARD_MODEL"')
    lines.append('    FILEBY="csv2edi.py"')
    lines.append(f'    LAT={lat:.6f}')
    lines.append(f'    LONG={lon:.6f}')
    lines.append(f'    ELEV={elev:.2f}')
    lines.append('    STDVERS="SEG 1.0"')
    lines.append('    UNITS=M')
    lines.append("")

    lines.append(">INFO")
    lines.append("    MAXINFO=200")
    lines.append("    Forward-modeled MT response converted to EDI.")
    lines.append("")

    lines.append(">=DEFINEMEAS")
    lines.append("    MAXCHAN=7")
    lines.append(f"    MAXRUN=1")
    lines.append(f"    MAXMEAS=1000")
    lines.append(f"    REFLAT={lat:.6f}")
    lines.append(f"    REFLONG={lon:.6f}")
    lines.append(f"    REFELEV={elev:.2f}")
    lines.append("    REFTYPE=CART")
    lines.append("    UNITS=M")
    lines.append("")
    lines.append(">HMEAS ID=1001.001 CHTYPE=HX X=0. Y=0. AZM=0.")
    lines.append(">HMEAS ID=1002.001 CHTYPE=HY X=0. Y=0. AZM=90.")
    lines.append(">HMEAS ID=1003.001 CHTYPE=HZ X=0. Y=0. AZM=0.")
    lines.append(">EMEAS ID=1004.001 CHTYPE=EX X=0. Y=0. X2=0. Y2=0. AZM=0.")
    lines.append(">EMEAS ID=1005.001 CHTYPE=EY X=0. Y=0. X2=0. Y2=0. AZM=90.")
    lines.append("")

    lines.append(">=MTSECT")
    lines.append(f'    SECTID="{station_name}"')
    lines.append("    NFREQ=%d" % nfreq)
    lines.append("    HX=1001.001 HY=1002.001 HZ=1003.001 EX=1004.001 EY=1005.001")
    lines.append("")

    lines.append(">!****FREQUENCIES****!")
    lines.append(f">FREQ NFREQ={nfreq} ORDER=DEC //{nfreq}")
    lines.extend(wrap_values(freqs))
    lines.append("")

    lines.append(">!****IMPEDANCE ROTATION ANGLES****!")
    lines.append(f">ZROT //{nfreq}")
    lines.extend(wrap_values([0.0] * nfreq))
    lines.append("")

    lines.append(">!****IMPEDANCES****!")
    for comp in Z_COMPONENTS:
        zc = z.get(comp)
        varc = zvar.get(comp)
        tag = comp  # ZXX / ZXY / ZYX / ZYY
        if zc is None:
            continue
        real_vals = [v.real for v in zc]
        imag_vals = [v.imag for v in zc]
        lines.append(f">{tag}R ROT=ZROT //{nfreq}")
        lines.extend(wrap_values(real_vals))
        lines.append(f">{tag}I ROT=ZROT //{nfreq}")
        lines.extend(wrap_values(imag_vals))
        lines.append(f">{tag}.VAR ROT=ZROT //{nfreq}")
        lines.extend(wrap_values(varc))
    lines.append("")

    if any(t.get(c) is not None for c in T_COMPONENTS):
        lines.append(">!****TIPPER PARAMETERS****!")
        lines.append(f">TROT //{nfreq}")
        lines.extend(wrap_values([0.0] * nfreq))
        for comp in T_COMPONENTS:
            tc = t.get(comp)
            varc = tvar.get(comp)
            if tc is None:
                continue
            suffix = "X" if comp == "TZX" else "Y"
            real_vals = [v.real for v in tc]
            imag_vals = [v.imag for v in tc]
            lines.append(f">T{suffix}R.EXP TROT=TROT //{nfreq}")
            lines.extend(wrap_values(real_vals))
            lines.append(f">T{suffix}I.EXP TROT=TROT //{nfreq}")
            lines.extend(wrap_values(imag_vals))
            lines.append(f">T{suffix}VAR.EXP TROT=TROT //{nfreq}")
            lines.extend(wrap_values(varc))
        lines.append("")

    lines.append(">END")

    with open(path, "w") as f:
        f.write("\n".join(lines) + "\n")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("input", help="path to the custom forward-model output file")
    ap.add_argument("--outdir", default="edi_out", help="output directory for .edi files")
    ap.add_argument("--coord-type", choices=["latlon", "utm"], default="latlon")
    ap.add_argument("--utm-zone", type=int, default=None)
    ap.add_argument("--utm-hemisphere", choices=["N", "S"], default="N")
    ap.add_argument("--unit-conversion", choices=["none", "si2field"], default="none")
    ap.add_argument("--error-fraction", type=float, default=0.05)
    ap.add_argument("--min-error", type=float, default=1e-6,
                     help="floor on |value| used for variance when value is ~0")
    ap.add_argument("--station-prefix", default="STN")
    ap.add_argument("--elevation", type=float, default=0.0,
                     help="elevation to write if not otherwise available")
    args = ap.parse_args()

    os.makedirs(args.outdir, exist_ok=True)

    freqs, stations = parse_input(args.input)
    nfreq = len(freqs)
    conv = SI_TO_FIELD if args.unit_conversion == "si2field" else 1.0

    for i, st in enumerate(stations, start=1):
        x, y = st["loc"]
        data = st["data"]

        if args.coord_type == "utm":
            if args.utm_zone is None:
                sys.exit("--utm-zone is required when --coord-type utm")
            lat, lon = utm_to_latlon(x, y, args.utm_zone, args.utm_hemisphere)
        else:
            # Assumes Xloc=longitude, Yloc=latitude. Swap below if your file
            # instead lists (lat, lon) in that column order.
            lon, lat = x, y

        z, zvar = {}, {}
        for comp in Z_COMPONENTS:
            zc = build_complex(data, comp, nfreq)
            if zc is None:
                continue
            zc = [v * conv for v in zc]
            z[comp] = zc
            zvar[comp] = [max(args.error_fraction * abs(v), args.min_error) ** 2 for v in zc]

        t, tvar = {}, {}
        for comp in T_COMPONENTS:
            tc = build_complex(data, comp, nfreq)
            if tc is None:
                continue
            t[comp] = tc
            tvar[comp] = [max(args.error_fraction * abs(v), args.min_error) ** 2 for v in tc]

        station_name = f"{args.station_prefix}{i:04d}"
        out_path = os.path.join(args.outdir, f"{station_name}.edi")
        write_edi(out_path, station_name, lat, lon, args.elevation, freqs, z, zvar, t, tvar, len(z) + len(t))

    print(f"Wrote {len(stations)} EDI files to {args.outdir}/")


if __name__ == "__main__":
    main()